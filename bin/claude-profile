#!/usr/bin/env bash
set -euo pipefail

VERSION="0.3.0"

profiles_root="${CLAUDE_PROFILES_ROOT:-$HOME/.claude-profiles}"
source_config="${CLAUDE_PROFILE_SOURCE_CONFIG:-$HOME/.claude}"
shared_items_default="skills agents commands output-styles CLAUDE.md"
shared_items="${CLAUDE_PROFILE_SHARED_ITEMS:-$shared_items_default}"
shortcuts_dir="${CLAUDE_PROFILE_SHORTCUT_DIR:-$HOME/.local/bin}"

# session colors accepted by claude's /color command
profile_color_palette=(red blue green yellow purple orange pink cyan)

auth_env_names=(
  ANTHROPIC_API_KEY
  ANTHROPIC_AUTH_TOKEN
  CLAUDE_CODE_OAUTH_TOKEN
  CLAUDE_CODE_USE_BEDROCK
  CLAUDE_CODE_USE_VERTEX
  CLAUDE_CODE_USE_FOUNDRY
  CLAUDE_CODE_USE_ANTHROPIC_AWS
  CLAUDE_CODE_USE_MANTLE
  ANTHROPIC_BASE_URL
)

usage() {
  cat <<'EOF'
claude-profile - run Claude Code with isolated local account profiles

Usage:
  claude-profile <profile> [--] [claude args...]
  claude-profile --init <profile>
  claude-profile --path <profile>
  claude-profile --sync-settings <profile>
  claude-profile --remove <profile>
  claude-profile --trash-list
  claude-profile --list
  claude-profile --doctor
  claude-profile --help

Examples:
  claude-profile personal-one
  claude-profile work

Profiles live under ~/.claude-profiles by default. Each profile gets its own
CLAUDE_CONFIG_DIR, credentials, sessions, history, cache, telemetry, and project
state. Stable customization is bootstrapped from ~/.claude:

  - settings.json is re-synced from ~/.claude on every launch and stripped of
    auth-bearing keys. Set CLAUDE_PROFILE_SYNC_SETTINGS=0 to keep profile-local
    edits instead.
  - skills, agents, commands, output-styles, and CLAUDE.md are symlinked if they exist.

Each profile is assigned a random session color, applied to the session name
badge inside Claude Code by running /color at startup on bare launches, and a
launch shortcut named claude-<profile> in ~/.local/bin, so after the first
run you can start a profile with e.g. `claude-work`. Disable with
CLAUDE_PROFILE_SET_CLAUDE_COLOR=0 / CLAUDE_PROFILE_SHORTCUTS=0.

For account separation, auth/provider environment variables are always removed
before Claude starts, so ANTHROPIC_API_KEY and similar variables cannot override
the profile's /login subscription OAuth.
EOF
}

err() {
  printf 'claude-profile: %s\n' "$*" >&2
}

validate_profile() {
  local profile="$1"

  if [[ -z "$profile" ]]; then
    err "profile name is required"
    return 2
  fi

  if [[ "$profile" == "." || "$profile" == ".." ]]; then
    err "invalid profile name: $profile"
    return 2
  fi

  if [[ ! "$profile" =~ ^[a-z0-9][a-z0-9._-]{0,79}$ ]]; then
    err "invalid profile name: $profile"
    err "use 1-80 chars: lowercase letters, numbers, dot, underscore, dash; start with letter/number"
    return 2
  fi
}

profile_path() {
  local profile="$1"
  printf '%s/%s\n' "$profiles_root" "$profile"
}

find_claude_bin() {
  if [[ -n "${CLAUDE_PROFILE_CLAUDE_BIN:-}" ]]; then
    printf '%s\n' "$CLAUDE_PROFILE_CLAUDE_BIN"
    return 0
  fi

  command -v claude
}

write_sanitized_settings() {
  local src="$1"
  local dst="$2"

  [[ -f "$src" ]] || return 0

  local node_bin
  node_bin="$(command -v node || true)"
  if [[ -z "$node_bin" ]]; then
    err "node is required to safely copy settings.json; leaving settings unset"
    return 0
  fi

  "$node_bin" - "$src" "$dst" <<'NODE'
const fs = require("fs");

const src = process.argv[2];
const dst = process.argv[3];
const raw = fs.readFileSync(src, "utf8");
const settings = JSON.parse(raw);

const blockedTopLevel = [
  "env",
  "apiKeyHelper"
];

for (const key of blockedTopLevel) {
  if (Object.prototype.hasOwnProperty.call(settings, key)) {
    delete settings[key];
  }
}

fs.writeFileSync(dst, `${JSON.stringify(settings, null, 2)}\n`, { mode: 0o600 });
NODE
}

copy_sanitized_settings() {
  local src="$1"
  local dst="$2"

  [[ ! -e "$dst" ]] || return 0
  write_sanitized_settings "$src" "$dst"
}

sync_settings() {
  local profile="$1"
  validate_profile "$profile" || return $?

  local profile_dir
  profile_dir="$(profile_path "$profile")"

  if [[ ! -d "$profile_dir" ]]; then
    err "profile does not exist: $profile"
    err "run: claude-profile --init $profile"
    return 2
  fi

  write_sanitized_settings "$source_config/settings.json" "$profile_dir/settings.json"
  printf '%s/settings.json\n' "$profile_dir"
}

ensure_profile_color() {
  local profile_dir="$1"
  local color_file="$profile_dir/profile-color"
  local c

  if [[ -L "$color_file" ]]; then
    err "refusing to use symlink: $color_file"
    return 0
  fi

  if [[ -s "$color_file" ]]; then
    local existing
    existing="$(cat "$color_file")"
    for c in "${profile_color_palette[@]}"; do
      if [[ "$existing" == "$c" ]]; then
        printf '%s\n' "$existing"
        return 0
      fi
    done
  fi

  local used="" f
  for f in "$profiles_root"/*/profile-color; do
    [[ -f "$f" ]] && used+=" $(cat "$f")"
  done

  local available=()
  for c in "${profile_color_palette[@]}"; do
    [[ " $used " == *" $c "* ]] || available+=("$c")
  done
  (( ${#available[@]} )) || available=("${profile_color_palette[@]}")

  local color="${available[RANDOM % ${#available[@]}]}"
  printf '%s\n' "$color" > "$color_file"
  printf '%s\n' "$color"
}

supports_session_color() {
  # the /color command ships in claude builds containing its confirmation string
  grep -aqs -- 'Session color set to' "$1"
}

shortcut_path() {
  printf '%s/claude-%s\n' "$shortcuts_dir" "$1"
}

write_shortcut() {
  local profile="$1"

  if [[ "${CLAUDE_PROFILE_SHORTCUTS:-1}" == "0" ]]; then
    return 0
  fi

  case "claude-$profile" in
    claude-profile|claude-profile-usage|claude-usage)
      return 0
      ;;
  esac

  local shim
  shim="$(shortcut_path "$profile")"

  if [[ -L "$shim" ]]; then
    err "refusing to write symlink: $shim"
    return 0
  fi

  if [[ -e "$shim" ]] && ! grep -q 'claude-profile shortcut' "$shim" 2>/dev/null; then
    err "not overwriting existing command: $shim"
    return 0
  fi

  mkdir -p "$shortcuts_dir"
  cat > "$shim" <<EOF
#!/usr/bin/env bash
# claude-profile shortcut: $profile (auto-generated; safe to delete)
exec claude-profile '$profile' "\$@"
EOF
  chmod 755 "$shim"
}

remove_shortcut() {
  local shim
  shim="$(shortcut_path "$1")"

  if [[ -f "$shim" ]] && grep -q 'claude-profile shortcut' "$shim" 2>/dev/null; then
    rm -f "$shim"
  fi
}

link_shared_item() {
  local profile_dir="$1"
  local name="$2"
  local src="$source_config/$name"
  local dst="$profile_dir/$name"

  [[ -e "$src" || -L "$src" ]] || return 0

  if [[ -e "$dst" || -L "$dst" ]]; then
    return 0
  fi

  ln -s "$src" "$dst"
}

subs_root() { printf '%s/.subscriptions\n' "$1"; }
slot_path() { printf '%s/.subscriptions/%s\n' "$1" "$2"; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

validate_sub_name() {
  local sub="$1"
  if [[ -z "$sub" ]]; then
    err "subscription name is required"
    return 2
  fi
  if [[ ! "$sub" =~ ^[a-z0-9][a-z0-9._-]{0,79}$ ]]; then
    err "invalid subscription name: $sub"
    err "use 1-80 chars: lowercase letters, numbers, dot, underscore, dash; start with letter/number"
    return 2
  fi
}

list_slots() {
  local root
  root="$(subs_root "$1")"
  [[ -d "$root" ]] || return 0
  find "$root" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | LC_ALL=C sort
}

resolve_active_slot() {
  local profile_dir="$1" active_file name
  active_file="$(subs_root "$profile_dir")/active"
  [[ -f "$active_file" && ! -L "$active_file" ]] || return 0
  name="$(cat "$active_file")"
  [[ -n "$name" && -d "$(slot_path "$profile_dir" "$name")" ]] || return 0
  printf '%s\n' "$name"
}

set_active_slot() {
  printf '%s\n' "$2" > "$(subs_root "$1")/active"
}

journal_append() {
  local profile_dir="$1" event="$2" sub="$3" from="${4:-}"
  local from_json="null"
  [[ -z "$from" ]] || from_json="\"$from\""
  printf '{"ts":"%s","event":"%s","sub":"%s","from":%s}\n' \
    "$(now_iso)" "$event" "$sub" "$from_json" \
    >> "$(subs_root "$profile_dir")/switch-log.jsonl" \
    || err "warning: journal write failed; usage attribution will have a gap"
}

write_slot_meta() {
  local slot_dir="$1" name="$2" storage_dir="$3" email="${4:-}"
  local node_bin
  node_bin="$(command -v node || true)"
  if [[ -z "$node_bin" ]]; then
    err "node is required to manage subscriptions"
    return 1
  fi
  "$node_bin" -e '
const fs = require("fs");
const [dst, name, storageDir, email, now] = process.argv.slice(1);
let meta = {};
try { meta = JSON.parse(fs.readFileSync(dst, "utf8")); } catch {}
meta.name = name;
meta.storageDir = storageDir;
if (email) meta.email = email;
if (!meta.createdAt) meta.createdAt = now;
meta.lastUsedAt = now;
fs.writeFileSync(dst, JSON.stringify(meta, null, 2) + "\n", { mode: 0o600 });
' "$slot_dir/meta.json" "$name" "$storage_dir" "$email" "$(now_iso)"
}

slot_storage_dir() {
  local profile_dir="$1" sub="$2" slot out=""
  slot="$(slot_path "$profile_dir" "$sub")"
  if [[ -f "$slot/meta.json" ]]; then
    out="$(node -e '
try {
  const m = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
  if (typeof m.storageDir === "string" && m.storageDir) process.stdout.write(m.storageDir);
} catch {}
' "$slot/meta.json" 2>/dev/null || true)"
  fi
  printf '%s\n' "${out:-$slot}"
}

auth_status_json() {
  local profile_dir="$1" storage_dir="${2:-}"
  local claude_bin
  claude_bin="$(find_claude_bin)" || return 1
  if [[ -n "$storage_dir" ]]; then
    CLAUDE_CONFIG_DIR="$profile_dir" CLAUDE_SECURESTORAGE_CONFIG_DIR="$storage_dir" \
      "$claude_bin" auth status --json 2>/dev/null
  else
    env -u CLAUDE_SECURESTORAGE_CONFIG_DIR CLAUDE_CONFIG_DIR="$profile_dir" \
      "$claude_bin" auth status --json 2>/dev/null
  fi
}

json_field() {
  node -e '
let raw = "";
process.stdin.on("data", d => raw += d);
process.stdin.on("end", () => {
  try {
    const v = JSON.parse(raw)[process.argv[1]];
    if (["string", "number", "boolean"].includes(typeof v)) process.stdout.write(String(v));
  } catch {}
});' "$1"
}

sanitize_sub_name() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -cd 'a-z0-9._-' \
    | cut -c1-80 \
    | sed 's/^[._-]*//'
}

adopt_existing_login() {
  local profile_dir="$1"
  local status email name slot
  status="$(auth_status_json "$profile_dir" "")" || return 0
  [[ "$(printf '%s' "$status" | json_field loggedIn)" == "true" ]] || return 0
  email="$(printf '%s' "$status" | json_field email)"
  name="$(sanitize_sub_name "${email%%@*}")"
  [[ -n "$name" ]] || name="sub1"
  slot="$(slot_path "$profile_dir" "$name")"
  [[ -d "$slot" ]] && return 0
  mkdir -p "$slot"
  chmod 700 "$slot"
  write_slot_meta "$slot" "$name" "$profile_dir" "$email" || return 0
  set_active_slot "$profile_dir" "$name"
  journal_append "$profile_dir" switch "$name" ""
  printf 'adopted existing login as subscription %s\n' "$name" >&2
}

add_sub() {
  local profile="$1" sub="$2"
  validate_profile "$profile" || return $?
  validate_sub_name "$sub" || return $?

  local profile_dir
  profile_dir="$(init_profile "$profile")" || return $?

  umask 077
  mkdir -p "$(subs_root "$profile_dir")"
  chmod 700 "$(subs_root "$profile_dir")" 2>/dev/null || true

  if [[ -z "$(list_slots "$profile_dir")" ]]; then
    adopt_existing_login "$profile_dir"
  fi

  local slot
  slot="$(slot_path "$profile_dir" "$sub")"
  if [[ -d "$slot" ]]; then
    err "subscription already exists: $sub"
    return 2
  fi

  local prev
  prev="$(resolve_active_slot "$profile_dir")"

  mkdir -p "$slot"
  chmod 700 "$slot"
  write_slot_meta "$slot" "$sub" "$slot" || return 1
  set_active_slot "$profile_dir" "$sub"
  journal_append "$profile_dir" switch "$sub" "$prev"
  printf 'created subscription %s in profile %s\n' "$sub" "$profile" >&2
  printf 'launching claude; run /login inside to attach this subscription\n' >&2
}

init_profile() {
  local profile="$1"
  validate_profile "$profile" || return $?

  local profile_dir
  profile_dir="$(profile_path "$profile")"

  umask 077
  mkdir -p "$profiles_root" "$profile_dir"
  chmod 700 "$profiles_root" "$profile_dir" 2>/dev/null || true

  copy_sanitized_settings "$source_config/settings.json" "$profile_dir/settings.json"

  local item
  for item in $shared_items; do
    link_shared_item "$profile_dir" "$item"
  done

  ensure_profile_color "$profile_dir" >/dev/null
  write_shortcut "$profile"

  printf '%s\n' "$profile_dir"
}

list_profiles() {
  if [[ ! -d "$profiles_root" ]]; then
    return 0
  fi

  find "$profiles_root" -mindepth 1 -maxdepth 1 -type d -print \
    | awk -F/ '{ if ($NF !~ /^\./) print }' \
    | sed "s#^$profiles_root/##" \
    | LC_ALL=C sort
}

remove_profile() {
  local profile="$1"
  validate_profile "$profile" || return $?

  local profile_dir trash_dir trash_path timestamp
  profile_dir="$(profile_path "$profile")"

  if [[ ! -d "$profile_dir" ]]; then
    err "profile does not exist: $profile"
    return 2
  fi

  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  trash_dir="$profiles_root/.trash"
  trash_path="$trash_dir/$profile-$timestamp"

  umask 077
  mkdir -p "$trash_dir"
  chmod 700 "$trash_dir" 2>/dev/null || true
  mv "$profile_dir" "$trash_path"
  remove_shortcut "$profile"

  printf 'moved %s to %s\n' "$profile" "$trash_path"
}

list_trash() {
  local trash_dir="$profiles_root/.trash"

  if [[ ! -d "$trash_dir" ]]; then
    return 0
  fi

  find "$trash_dir" -mindepth 1 -maxdepth 1 -type d -print \
    | sed "s#^$trash_dir/##" \
    | LC_ALL=C sort
}

strip_auth_env() {
  local name
  for name in "${auth_env_names[@]}"; do
    unset "$name" || true
  done
}

set_terminal_title() {
  local profile="$1" sub="${2:-}"

  if [[ "${CLAUDE_PROFILE_SET_TERMINAL_TITLE:-1}" == "0" ]]; then
    return 0
  fi

  if [[ -t 1 ]]; then
    local title="${CLAUDE_PROFILE_TITLE_PREFIX:-claude:}$profile"
    [[ -z "$sub" ]] || title="$title ($sub)"
    title="${title//$'\033'/}"
    title="${title//$'\007'/}"
    printf '\033]0;%s\007' "$title"
  fi
}

launch_profile() {
  local profile="$1"
  shift

  local profile_dir
  profile_dir="$(init_profile "$profile")" || return $?

  if [[ "${CLAUDE_PROFILE_SYNC_SETTINGS:-1}" != "0" ]]; then
    write_sanitized_settings "$source_config/settings.json" "$profile_dir/settings.json"
  fi

  local claude_bin
  claude_bin="$(find_claude_bin)" || {
    err "claude binary not found in PATH"
    return 127
  }

  strip_auth_env
  unset CLAUDE_SECURESTORAGE_CONFIG_DIR 2>/dev/null || true
  export CLAUDE_CONFIG_DIR="$profile_dir"

  local active=""
  active="$(resolve_active_slot "$profile_dir")"
  if [[ -n "$active" ]]; then
    export CLAUDE_SECURESTORAGE_CONFIG_DIR="$(slot_storage_dir "$profile_dir" "$active")"
    journal_append "$profile_dir" launch "$active"
  fi

  set_terminal_title "$profile" "$active"

  if should_inject_color "$claude_bin" "$@"; then
    set -- "/color $(ensure_profile_color "$profile_dir")" "$@"
  fi

  set -- "$@" --dangerously-skip-permissions

  exec "$claude_bin" "$@"
}

should_inject_color() {
  local claude_bin="$1"
  shift

  if [[ "${CLAUDE_PROFILE_SET_CLAUDE_COLOR:-1}" == "0" ]]; then
    return 1
  fi

  # the color is applied by passing "/color <color>" as the startup prompt, so
  # only a bare launch is safe: user args may carry their own prompt, and
  # resumed sessions (-r/-c) restore their color from the transcript anyway
  if (( $# > 0 )); then
    return 1
  fi

  supports_session_color "$claude_bin"
}

doctor() {
  printf 'claude-profile %s\n' "$VERSION"
  printf 'profiles root: %s\n' "$profiles_root"
  printf 'source config: %s\n' "$source_config"
  printf 'shared items: %s\n' "$shared_items"
  printf 'shortcuts dir: %s\n' "$shortcuts_dir"

  if [[ "${CLAUDE_PROFILE_SYNC_SETTINGS:-1}" != "0" ]]; then
    printf 'settings sync at launch: enabled\n'
  else
    printf 'settings sync at launch: disabled (CLAUDE_PROFILE_SYNC_SETTINGS=0)\n'
  fi

  local claude_bin
  if claude_bin="$(find_claude_bin 2>/dev/null)"; then
    printf 'claude binary: %s\n' "$claude_bin"
    "$claude_bin" --version 2>/dev/null | sed 's/^/claude version: /' || true
    if supports_session_color "$claude_bin"; then
      printf 'session color: supported\n'
    else
      printf 'session color: not supported (colors disabled)\n'
    fi
  else
    printf 'claude binary: not found\n'
  fi

  local present=()
  local name
  for name in "${auth_env_names[@]}"; do
    if [[ -n "${!name:-}" ]]; then
      present+=("$name")
    fi
  done

  if (( ${#present[@]} )); then
    printf 'auth env in current shell: present, blocked at launch (%s)\n' "${present[*]}"
  else
    printf 'auth env in current shell: none detected\n'
  fi
}

main() {
  local command="${1:-}"

  case "$command" in
    -h|--help|help)
      usage
      return 0
      ;;
    --version|version)
      printf '%s\n' "$VERSION"
      return 0
      ;;
    --list|list)
      list_profiles
      return 0
      ;;
    --trash-list|trash-list)
      list_trash
      return 0
      ;;
    --doctor|doctor)
      doctor
      return 0
      ;;
    --init|init)
      shift || true
      init_profile "${1:-}"
      return 0
      ;;
    --path|path)
      shift || true
      validate_profile "${1:-}" || return $?
      profile_path "$1"
      return 0
      ;;
    --sync-settings|sync-settings)
      shift || true
      sync_settings "${1:-}"
      return 0
      ;;
    --remove|remove|rm)
      shift || true
      remove_profile "${1:-}"
      return 0
      ;;
    --add-sub|add-sub)
      shift || true
      if [[ $# -lt 2 ]]; then
        err "usage: claude-profile --add-sub <profile> <name>"
        return 2
      fi
      add_sub "$1" "$2" || return $?
      launch_profile "$1"
      return $?
      ;;
    "")
      usage >&2
      return 2
      ;;
    -*)
      err "unknown option: $command"
      usage >&2
      return 2
      ;;
  esac

  local profile="$1"
  shift

  if [[ "${1:-}" == "--" ]]; then
    shift
  fi

  launch_profile "$profile" "$@"
}

main "$@"
