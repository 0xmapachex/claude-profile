#!/usr/bin/env bash
set -euo pipefail

profiles_root="${CLAUDE_PROFILES_ROOT:-$HOME/.claude-profiles}"
ccusage_package="${CLAUDE_PROFILE_CCUSAGE_PACKAGE:-ccusage@latest}"

usage() {
  cat <<'EOF'
claude-profile-usage - local Claude Code usage by logged-in claude-profile profiles

Usage:
  claude-profile-usage [period] [--json] [ccusage args...]

Periods:
  daily      Summarize daily local usage totals per profile (default)
  weekly     Summarize weekly local usage totals per profile
  monthly    Summarize monthly local usage totals per profile

Examples:
  claude-profile-usage
  claude-profile-usage monthly
  claude-profile-usage daily --since 2026-06-01

Notes:
  - This reports local Claude Code usage logs, not live subscription quota.
  - Only profiles where `claude auth status --json` reports loggedIn=true are
    included; profiles with subscriptions are always included, one row per
    subscription (tokens attributed by the switch journal) plus a total row.
  - Simultaneous sessions on different subscriptions of one profile blur
    attribution within the overlap.
  - --json prints machine-readable rows instead of a table.
  - It does not read or print OAuth tokens.
EOF
}

err() {
  printf 'claude-profile-usage: %s\n' "$*" >&2
}

find_claude_bin() {
  if [[ -n "${CLAUDE_PROFILE_CLAUDE_BIN:-}" ]]; then
    printf '%s\n' "$CLAUDE_PROFILE_CLAUDE_BIN"
    return 0
  fi

  command -v claude
}

find_profiles() {
  if [[ ! -d "$profiles_root" ]]; then
    return 0
  fi

  find "$profiles_root" -mindepth 1 -maxdepth 1 -type d -print \
    | awk -F/ '{ if ($NF !~ /^\./) print }' \
    | LC_ALL=C sort
}

profile_name_from_path() {
  local path="$1"
  basename "$path"
}

profile_logged_in() {
  local profile_dir="$1"
  local claude_bin="$2"
  local status_json

  if ! status_json="$(env -u CLAUDE_SECURESTORAGE_CONFIG_DIR CLAUDE_CONFIG_DIR="$profile_dir" "$claude_bin" auth status --json 2>/dev/null)"; then
    return 1
  fi

  node -e '
let raw = "";
process.stdin.on("data", d => raw += d);
process.stdin.on("end", () => {
  try {
    const status = JSON.parse(raw);
    process.exit(status.loggedIn === true ? 0 : 1);
  } catch {
    process.exit(1);
  }
});
' <<<"$status_json"
}

run_ccusage_json() {
  local profile_dir="$1"
  local period="$2"
  shift 2

  if command -v ccusage >/dev/null 2>&1; then
    CLAUDE_CONFIG_DIR="$profile_dir" ccusage claude "$period" --json --offline "$@"
  elif command -v npx >/dev/null 2>&1; then
    CLAUDE_CONFIG_DIR="$profile_dir" npx -y "$ccusage_package" claude "$period" --json --offline "$@"
  else
    err "ccusage or npx is required for usage reports"
    return 127
  fi
}

json_string_array() {
  # the -- keeps node from parsing dash-prefixed ccusage args as its own options
  node -e 'console.log(JSON.stringify(process.argv.slice(1)))' -- "$@"
}

list_slots() {
  local root="$1/.subscriptions"
  [[ -d "$root" ]] || return 0
  find "$root" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | LC_ALL=C sort
}

active_slot() {
  local f="$1/.subscriptions/active" name
  [[ -f "$f" ]] || return 0
  name="$(cat "$f")"
  [[ -n "$name" && -d "$1/.subscriptions/$name" ]] || return 0
  printf '%s\n' "$name"
}

since_to_iso() {
  # ccusage --since takes YYYYMMDD; normalize to ISO for message filtering
  local s="$1"
  if [[ "$s" =~ ^[0-9]{8}$ ]]; then
    printf '%s-%s-%sT00:00:00Z\n' "${s:0:4}" "${s:4:2}" "${s:6:2}"
  elif [[ "$s" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    printf '%sT00:00:00Z\n' "$s"
  else
    printf '%s\n' "$s"
  fi
}

sub_token_rows() {
  local profile_dir="$1" since_iso="${2:-}" until_iso="${3:-}"
  node - "$profile_dir/.subscriptions/switch-log.jsonl" "$profile_dir/projects" "$since_iso" "$until_iso" <<'NODE'
const fs = require("fs");
const path = require("path");
const [journalPath, projectsDir, since, until] = process.argv.slice(2);

const sinceMs = since ? Date.parse(since) : -Infinity;
// until names an inclusive day; the bound is the start of the next day
const untilMs = until ? Date.parse(until) + 86400000 : Infinity;

let events = [];
try {
  events = fs.readFileSync(journalPath, "utf8")
    .split("\n").filter(Boolean)
    .map(l => { try { return JSON.parse(l); } catch { return null; } })
    .filter(e => e && e.ts && e.sub)
    .map(e => ({ sub: e.sub, tsMs: Date.parse(e.ts) }))
    .filter(e => Number.isFinite(e.tsMs))
    .sort((a, b) => a.tsMs - b.tsMs);
} catch {}

function subAt(ms) {
  let lo = 0, hi = events.length - 1, ans = -1;
  while (lo <= hi) {
    const mid = (lo + hi) >> 1;
    if (events[mid].tsMs <= ms) { ans = mid; lo = mid + 1; } else { hi = mid - 1; }
  }
  return ans >= 0 ? events[ans].sub : "(pre-subscriptions)";
}

function* jsonlFiles(dir) {
  let entries = [];
  try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
  for (const ent of entries) {
    const p = path.join(dir, ent.name);
    if (ent.isDirectory()) yield* jsonlFiles(p);
    else if (ent.name.endsWith(".jsonl")) yield p;
  }
}

const totals = {};
const seen = new Set();
function bucket(sub) {
  return totals[sub] ??= {
    sub, inputTokens: 0, outputTokens: 0,
    cacheCreationTokens: 0, cacheReadTokens: 0,
    totalTokens: 0, messages: 0
  };
}

for (const file of jsonlFiles(projectsDir)) {
  let lines;
  try { lines = fs.readFileSync(file, "utf8").split("\n"); } catch { continue; }
  for (const line of lines) {
    if (!line.trim()) continue;
    let entry;
    try { entry = JSON.parse(line); } catch { continue; }
    const usage = entry?.message?.usage;
    if (!usage || !entry.timestamp) continue;
    const ms = Date.parse(entry.timestamp);
    if (!Number.isFinite(ms) || ms < sinceMs || ms >= untilMs) continue;
    const key = entry.message.id && entry.requestId
      ? `${entry.message.id}:${entry.requestId}` : null;
    if (key) {
      if (seen.has(key)) continue;
      seen.add(key);
    }
    const b = bucket(subAt(ms));
    const inp = usage.input_tokens ?? 0;
    const out = usage.output_tokens ?? 0;
    const cc = usage.cache_creation_input_tokens ?? 0;
    const cr = usage.cache_read_input_tokens ?? 0;
    b.inputTokens += inp;
    b.outputTokens += out;
    b.cacheCreationTokens += cc;
    b.cacheReadTokens += cr;
    b.totalTokens += inp + out + cc + cr;
    b.messages += 1;
  }
}
console.log(JSON.stringify(Object.values(totals).sort((a, b) => a.sub.localeCompare(b.sub))));
NODE
}

main() {
  local as_json=0
  if [[ "${1:-}" == "--json" ]]; then
    as_json=1
    shift || true
  fi

  local period="${1:-daily}"

  case "$period" in
    -h|--help|help)
      usage
      return 0
      ;;
    daily|weekly|monthly)
      shift || true
      ;;
    *)
      err "invalid period: $period"
      usage >&2
      return 2
      ;;
  esac

  if [[ "${1:-}" == "--json" ]]; then
    as_json=1
    shift || true
  fi

  local claude_bin
  claude_bin="$(find_claude_bin)" || {
    err "claude binary not found in PATH"
    return 127
  }

  local rows_file
  rows_file="$(mktemp "${TMPDIR:-/tmp}/claude-usage-rows.XXXXXX")"
  trap "rm -f '$rows_file'" EXIT
  printf '[]' > "$rows_file"

  local profile_dir profile status ccusage_json args_json
  local slots sub_rows active since_iso="" until_iso="" prev="" a
  args_json="$(json_string_array "$@")"

  for a in "$@"; do
    case "$a" in
      --since=*) since_iso="$(since_to_iso "${a#--since=}")" ;;
      --until=*) until_iso="$(since_to_iso "${a#--until=}")" ;;
    esac
    [[ "$prev" == "--since" ]] && since_iso="$(since_to_iso "$a")"
    [[ "$prev" == "--until" ]] && until_iso="$(since_to_iso "$a")"
    prev="$a"
  done

  while IFS= read -r profile_dir; do
    [[ -n "$profile_dir" ]] || continue
    profile="$(profile_name_from_path "$profile_dir")"

    slots="$(list_slots "$profile_dir")"
    if [[ -z "$slots" ]] && ! profile_logged_in "$profile_dir" "$claude_bin"; then
      continue
    fi

    sub_rows='[]'
    active=""
    if [[ -n "$slots" ]]; then
      active="$(active_slot "$profile_dir")"
      sub_rows="$(sub_token_rows "$profile_dir" "$since_iso" "$until_iso")"
    fi

    if ccusage_json="$(run_ccusage_json "$profile_dir" "$period" "$@" 2>/dev/null)"; then
      status="ok"
    else
      status="usage-unavailable"
      ccusage_json='{}'
    fi

    CCUSAGE_JSON="$ccusage_json" SUB_ROWS_JSON="$sub_rows" ACTIVE_SUB="$active" SLOT_NAMES="$slots" \
      node - "$rows_file" "$profile" "$profile_dir" "$period" "$status" "$args_json" <<'NODE'
const fs = require("fs");

const [rowsPath, profile, profileDir, period, status, argsJson] = process.argv.slice(2);
const args = JSON.parse(argsJson);
let ccusage = {};
const raw = process.env.CCUSAGE_JSON ?? "";

if (raw.trim()) {
  try {
    ccusage = JSON.parse(raw);
  } catch {
    ccusage = {};
  }
}

const totals = ccusage.totals ?? {};
const list = ccusage[period] ?? [];
const latest = Array.isArray(list) && list.length > 0 ? list[list.length - 1] : null;

const row = {
  profile,
  profileDir,
  status,
  periods: Array.isArray(list) ? list.length : 0,
  totalTokens: Number(totals.totalTokens ?? 0),
  inputTokens: Number(totals.inputTokens ?? 0),
  outputTokens: Number(totals.outputTokens ?? 0),
  cacheCreationTokens: Number(totals.cacheCreationTokens ?? 0),
  cacheReadTokens: Number(totals.cacheReadTokens ?? 0),
  totalCost: Number(totals.totalCost ?? 0),
  latestPeriod: latest?.date ?? latest?.period ?? "",
  latestTokens: Number(latest?.totalTokens ?? 0),
  args
};

const rows = JSON.parse(fs.readFileSync(rowsPath, "utf8"));

const subRows = JSON.parse(process.env.SUB_ROWS_JSON || "[]");
const activeSub = process.env.ACTIVE_SUB || "";
const slotNames = (process.env.SLOT_NAMES || "").split("\n").filter(Boolean);
if (slotNames.length > 0) {
  const grand = subRows.reduce((n, r) => n + r.totalTokens, 0) || 1;
  const known = new Set(subRows.map(r => r.sub));
  for (const name of slotNames) {
    if (!known.has(name)) subRows.push({
      sub: name, inputTokens: 0, outputTokens: 0,
      cacheCreationTokens: 0, cacheReadTokens: 0, totalTokens: 0, messages: 0
    });
  }
  for (const r of subRows.sort((a, b) => a.sub.localeCompare(b.sub))) {
    rows.push({
      profile, sub: r.sub,
      status: r.sub === activeSub ? "active" : (slotNames.includes(r.sub) ? "stored" : "history"),
      periods: row.periods,
      totalTokens: r.totalTokens,
      inputTokens: r.inputTokens,
      outputTokens: r.outputTokens,
      cacheCreationTokens: r.cacheCreationTokens,
      cacheReadTokens: r.cacheReadTokens,
      totalCost: row.totalCost * (r.totalTokens / grand),
      latestPeriod: row.latestPeriod,
      latestTokens: row.latestTokens,
      args
    });
  }
}

rows.push(row);
fs.writeFileSync(rowsPath, JSON.stringify(rows));
NODE
  done < <(find_profiles)

  node - "$rows_file" "$period" "$as_json" <<'NODE'
const fs = require("fs");

const [rowsPath, period, asJsonFlag] = process.argv.slice(2);
const rows = JSON.parse(fs.readFileSync(rowsPath, "utf8"));

if (asJsonFlag === "1") {
  console.log(JSON.stringify(rows));
  process.exit(0);
}

function fmtInt(value) {
  return new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(value);
}

function fmtMoney(value) {
  return `$${new Intl.NumberFormat("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  }).format(value)}`;
}

if (rows.length === 0) {
  console.log("No logged-in claude-profile profiles found.");
  console.log("Run `claude-profile <name>` and use /login inside Claude first.");
  process.exit(0);
}

const table = rows.map(row => ({
  Profile: row.sub ? `${row.profile}/${row.sub}` : row.profile,
  Status: row.status,
  [`${period} periods`]: row.periods,
  "Total tokens": fmtInt(row.totalTokens),
  "Input": fmtInt(row.inputTokens),
  "Output": fmtInt(row.outputTokens),
  "Cache write": fmtInt(row.cacheCreationTokens),
  "Cache read": fmtInt(row.cacheReadTokens),
  "Est. cost": fmtMoney(row.totalCost),
  "Latest": row.latestPeriod || "-"
}));

console.table(table);
console.log("Source: local Claude Code logs via ccusage. This is not live subscription quota.");
NODE
}

main "$@"
